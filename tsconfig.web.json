{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "none",
    "moduleDetection": "legacy",
    "rootDir": "./src/web",
    "outDir": ".",
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "removeComments": false,
    "sourceMap": false,
    "declaration": false,
    "skipLibCheck": true,
    "types": [],
    "newLine": "crlf"
  },
  "include": ["src/web/**/*.ts"],
  "exclude": ["node_modules"]
}
