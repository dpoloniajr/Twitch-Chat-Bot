// Load custom commands from dashboard
async function loadCustomCommands() {
  try {
    const res = await axios.get(`${dashboardBaseUrl}/api/custom-commands`);
    customCommands = res.data || [];
  } catch (error) {
    customCommands = [];
  }
}

function isOnCooldown(cmdName, cooldownSeconds) {
  if (!cooldownSeconds || cooldownSeconds <= 0) return false;
  const last = commandCooldowns.get(cmdName) || 0;
  return Date.now() - last < cooldownSeconds * 1000;
}

function setCooldown(cmdName) {
  commandCooldowns.set(cmdName, Date.now());
}

async function renderCustomCommand(cmd, context) {
  let data = '';

  if (cmd.fetchEnabled && cmd.fetchUrl) {
    try {
      const resp = await axios.get(cmd.fetchUrl, { timeout: 5000 });
      data = typeof resp.data === 'string' ? resp.data : JSON.stringify(resp.data);
    } catch (err) {
      return { error: `Failed to fetch URL: ${err.message}` };
    }
  }

  const template = (cmd.response && cmd.response.trim().length > 0) ? cmd.response : '{data}';
  const rendered = formatResponse(template, { ...context, data });
  return { rendered };
}

// Get broadcaster ID
async function init() {
  try {
    console.log(`Initializing... (broadcaster: ${config.broadcasterName})`);
    
    const tokenInfo = await apiClient.getTokenInfo();
    tokenUserId = tokenInfo?.userId || null;
    if (!tokenUserId) {
      throw new Error('OAuth token missing userId; ensure the token is tied to a user account.');
    }

    const tokenUser = await apiClient.users.getUserById(tokenUserId);
    const user = await apiClient.users.getUserByName(config.broadcasterName);
    
    if (!user) {
      throw new Error(`Broadcaster "${config.broadcasterName}" not found. Check your .env TWITCH_BROADCASTER_NAME`);
    }
    
    broadcasterId = String(user.id);
    if (!/^\d+$/.test(broadcasterId)) {
      throw new Error(`Resolved broadcasterId is non-numeric: ${broadcasterId}`);
    }
    console.log(`✓ Got broadcaster ID: ${broadcasterId}`);
    console.log(`✓ Token user ID: ${tokenUserId} (${tokenUser?.name || 'unknown'})`);
    console.log(`⚠ Ensure ${tokenUser?.name || tokenUserId} is a moderator in the channel!`);
    
    // Update dashboard
    updateDashboard();
    initComplete = true;
    setupEventSub();
    startAnnouncements();
  } catch (error) {
    console.error('Failed to initialize bot:', error.message);
    broadcasterId = null;
    initComplete = true;
  }
}

// Create a clip
async function createClip() {
  try {
    if (!initComplete) {
      return { error: 'Bot is still initializing. Please try again in a moment.' };
    }

    if (!broadcasterId) {
      return { error: 'Bot not initialized. Broadcaster ID is missing. Restart the bot.' };
    }

    // Check if required scope is present
    if (!config.scopes.includes('clips:edit')) {
      console.error('Missing required scope: clips:edit');
      return { error: 'Missing clips:edit scope. Please re-authorize with the token generator.' };
    }

    // Ensure broadcasterId is a string
    const channelId = String(broadcasterId);
    console.log('[DEBUG] Calling create clip via Helix API. channelId:', channelId, 'scopes:', config.scopes);

    // Call Twitch Helix API directly to avoid extractUserId issues in Twurple clips API
    const response = await axios.post(
      'https://api.twitch.tv/helix/clips',
      { broadcaster_id: channelId },
      {
        headers: {
          'Client-ID': config.clientId,
          Authorization: `Bearer ${config.accessToken}`,
          'Content-Type': 'application/json'
        }
      }
    );

    const clipId = response.data?.data?.[0]?.id;
    if (!clipId) {
      console.error('[DEBUG] Clip API returned no clip ID. Response:', response.data);
      return { error: 'Clip API returned no clip ID' };
    }

    const clipUrl = `https://clips.twitch.tv/${clipId}`;
    console.log('[DEBUG] Clip created successfully. ID:', clipId, 'URL:', clipUrl);
    return { success: true, url: clipUrl };
  } catch (error) {
    console.error('Failed to create clip:', error?.response?.data || error);
    const errorMsg = (error?.response?.data?.message) || error.message || error.toString();
    return { error: errorMsg };
  }
  }

// Get follow age
async function getFollowAge(username) {
  try {
    const user = await apiClient.users.getUserByName(username);
    if (!user) return null;

    // getChannelFollowers returns a paginated result with a 'data' property
    const followsResult = await apiClient.channels.getChannelFollowers(broadcasterId, user.id);
    const follows = followsResult?.data || [];

    if (!follows || follows.length === 0) {
      return 'not following';
    }

    // Debug log to check the follower data structure
    console.log('[DEBUG] Follower data:', follows[0]);
    
    const followedAt = new Date(follows[0].followDate || follows[0].followedAt);
    if (isNaN(followedAt.getTime())) {
      console.error('[DEBUG] Invalid followedAt date:', follows[0]);
      return null;
    }
    
    const now = new Date();
    const diff = now - followedAt;
    
    const years = Math.floor(diff / (1000 * 60 * 60 * 24 * 365));
    const months = Math.floor((diff % (1000 * 60 * 60 * 24 * 365)) / (1000 * 60 * 60 * 24 * 30));
    const days = Math.floor((diff % (1000 * 60 * 60 * 24 * 30)) / (1000 * 60 * 60 * 24));
    
    let ageStr = '';
    if (years > 0) ageStr += `${years} year${years > 1 ? 's' : ''} `;
    if (months > 0) ageStr += `${months} month${months > 1 ? 's' : ''} `;
    if (days > 0 || ageStr === '') ageStr += `${days} day${days !== 1 ? 's' : ''}`;
    
    return ageStr.trim();
  } catch (error) {
    console.error('Failed to get follow age:', error.message);
    return null;
  }
}

// Send shoutout
async function sendShoutout(targetUsername) {
  try {
    const user = await apiClient.users.getUserByName(targetUsername);
    if (!user) return { success: false, error: 'User not found' };

    if (!tokenUserId) {
      return { success: false, error: 'Bot token missing user context; restart after re-auth.' };
    }

    // Get the user's channel information to find last played game
    const channelInfo = await apiClient.channels.getChannelInfoById(user.id);
    const gameName = channelInfo?.gameName || 'something awesome';

    // Check if the target user is live
    const streamInfo = await apiClient.streams.getStreamByUserId(user.id);
    const isLive = streamInfo !== null;

    if (isLive) {
      // Send the shoutout via API if they're live
      const response = await fetch(`https://api.twitch.tv/helix/chat/shoutouts?from_broadcaster_id=${broadcasterId}&to_broadcaster_id=${user.id}&moderator_id=${tokenUserId}`, {
        method: 'POST',
        headers: {
          'Authorization': `Bearer ${config.accessToken}`,
          'Client-Id': config.clientId
        }
      });

      if (!response.ok) {
        const errorData = await response.json();
        throw new Error(errorData.message || `HTTP ${response.status}`);
      }
    }
    
    return { 
      success: true, 
      username: user.displayName,
      gameName: gameName,
      isLive: isLive
    };
  } catch (error) {
    console.error('Failed to send shoutout:', error.message);
    return { success: false, error: error.message };
  }
}

// Update stream title (mods/broadcaster only)
async function updateStreamTitle(newTitle) {
  try {
    if (!initComplete || !broadcasterId) {
      return { success: false, error: 'Bot not initialized yet. Try again shortly.' };
    }
    if (!config.scopes.includes('channel:manage:broadcast')) {
      return { success: false, error: 'Missing scope: channel:manage:broadcast. Re-authorize via the token generator.' };
    }
    const title = String(newTitle || '').trim();
    if (!title) {
      return { success: false, error: 'Title cannot be empty.' };
    }
    await axios.patch(
      `https://api.twitch.tv/helix/channels?broadcaster_id=${broadcasterId}`,
      { title },
      {
        headers: {
          'Client-ID': config.clientId,
          Authorization: `Bearer ${config.accessToken}`,
          'Content-Type': 'application/json'
        }
      }
    );
    return { success: true, title };
  } catch (error) {
    const msg = (error?.response?.data?.message) || error.message || 'Unknown error';
    return { success: false, error: msg };
  }
}

// Update stream game/category (mods/broadcaster only)
async function updateStreamGame(gameName) {
  try {
    if (!initComplete || !broadcasterId) {
      return { success: false, error: 'Bot not initialized yet. Try again shortly.' };
    }
    if (!config.scopes.includes('channel:manage:broadcast')) {
      return { success: false, error: 'Missing scope: channel:manage:broadcast. Re-authorize via the token generator.' };
    }
    const name = String(gameName || '').trim();
    if (!name) {
      return { success: false, error: 'Game name cannot be empty.' };
    }

    // Resolve game ID by name via Helix API
    const headers = {
      'Client-ID': config.clientId,
      Authorization: `Bearer ${config.accessToken}`
    };
    let gameId = null;
    let resolvedName = name;
    try {
      const resp = await axios.get('https://api.twitch.tv/helix/games', { params: { name }, headers });
      const game = resp.data?.data?.[0] || null;
      if (game) {
        gameId = game.id;
        resolvedName = game.name || name;
      }
    } catch {}

    // Fallback to search categories
    if (!gameId) {
      try {
        const resp = await axios.get('https://api.twitch.tv/helix/search/categories', { params: { query: name }, headers });
        const cat = resp.data?.data?.[0] || null;
        if (cat) {
          gameId = cat.id;
          resolvedName = cat.name || name;
        }
      } catch {}
    }

    if (!gameId) {
      return { success: false, error: `Could not find a game/category named "${name}".` };
    }

    await axios.patch(
      `https://api.twitch.tv/helix/channels?broadcaster_id=${broadcasterId}`,
      { game_id: gameId },
      {
        headers: {
          'Client-ID': config.clientId,
          Authorization: `Bearer ${config.accessToken}`,
          'Content-Type': 'application/json'
        }
      }
    );
    return { success: true, gameId, gameName: resolvedName };
  } catch (error) {
    const msg = (error?.response?.data?.message) || error.message || 'Unknown error';
    return { success: false, error: msg };
  }
}

// Message handler
chatClient.onMessage(async (channel, user, message, msg) => {
  const username = msg.userInfo?.userName || msg.userInfo?.displayName || user || 'unknown';
  const text = message.trim().toLowerCase();
  const raw = message.trim();

  // push raw chat to dashboard feed
  axios.post(`${dashboardBaseUrl}/api/chat`, {
    channel,
    user: username,
    message
  }).catch(() => {});
  
  // !clip command
  if (text === '!clip') {
    const result = await createClip();
    if (result.success) {
      chatClient.say(channel, `@${username} Clip created! ${result.url}`);
      logCommand(username, '!clip', channel, true);
    } else {
      chatClient.say(channel, `@${username} Failed to create clip: ${result.error}`);
      logCommand(username, '!clip', channel, false);
    }
  }
  
  // !title command (mods/broadcaster only)
  if (text.startsWith('!title ')) {
    const isMod = msg.userInfo.isMod;
    const isBroadcaster = msg.userInfo.isBroadcaster;
    if (!isMod && !isBroadcaster) {
      chatClient.say(channel, `@${username} Only moderators and the broadcaster can use this command.`);
    } else {
      const newTitle = raw.slice('!title '.length).trim();
      const result = await updateStreamTitle(newTitle);
      if (result.success) {
        chatClient.say(channel, `@${username} Stream title updated to: ${result.title}`);
        logCommand(username, `!title`, channel, true);
      } else {
        chatClient.say(channel, `@${username} Failed to update title: ${result.error}`);
        logCommand(username, `!title`, channel, false);
      }
    }
  }

  // !game command (mods/broadcaster only)
  if (text.startsWith('!game ')) {
    const isMod = msg.userInfo.isMod;
    const isBroadcaster = msg.userInfo.isBroadcaster;
    if (!isMod && !isBroadcaster) {
      chatClient.say(channel, `@${username} Only moderators and the broadcaster can use this command.`);
    } else {
      const newGame = raw.slice('!game '.length).trim();
      const result = await updateStreamGame(newGame);
      if (result.success) {
        chatClient.say(channel, `@${username} Stream game updated to: ${result.gameName}`);
        logCommand(username, `!game`, channel, true);
      } else {
        chatClient.say(channel, `@${username} Failed to update game: ${result.error}`);
        logCommand(username, `!game`, channel, false);
      }
    }
  }
  // !followage command
  if (text.startsWith('!followage')) {
    const parts = text.split(' ');
    const targetUser = parts.length > 1 ? parts[1].replace('@', '') : username;
    
    const followAge = await getFollowAge(targetUser);
    if (followAge === 'not following') {
      chatClient.say(channel, `@${username} ${targetUser} is not following this channel.`);
    } else if (followAge) {
      chatClient.say(channel, `@${username} ${targetUser} has been following for ${followAge}!`);
    } else {
      chatClient.say(channel, `@${username} Could not retrieve follow age.`);
    }
    logCommand(username, `!followage ${targetUser}`, channel, followAge !== null);
  }

  // !poll command (start/end)
  if (text.startsWith('!poll ')) {
    const raw = message.trim();
    const isStart = raw.toLowerCase().startsWith('!poll start');
    try {
      if (isStart) {
        // Usage: !poll start "Title" option1;option2;option3 [durationSeconds]
        const match = raw.match(/!poll start\s+"([^"]+)"\s+([^\s]+)(?:\s+(\d+))?/i);
        if (!match) {
          chatClient.say(channel, `@${username} Usage: !poll start "Title" option1;option2;option3 [durationSeconds]`);
        } else {
          const title = match[1];
          const options = match[2].split(';').slice(0, 5);
          const duration = Number(match[3] || 60);
          await apiClient.polls.createPoll(broadcasterId, {
            title,
            choices: options.map(o => ({ title: o })),
            duration
          });
          chatClient.say(channel, `Poll started: ${title}`);
        }
      } else if (raw.toLowerCase().startsWith('!poll end')) {
        chatClient.say(channel, `@${username} Ending polls requires specifying poll ID (UI support TBD).`);
      }
    } catch (e) {
      chatClient.say(channel, `@${username} Failed to manage poll: ${e.message}`);
    }
  }

  // !prediction command (start/resolve)
  if (text.startsWith('!prediction ')) {
    const raw = message.trim();
    const isStart = raw.toLowerCase().startsWith('!prediction start');
    try {
      if (isStart) {
        // Usage: !prediction start "Title" outcomeA;outcomeB [durationSeconds]
        const match = raw.match(/!prediction start\s+"([^"]+)"\s+([^\s]+)(?:\s+(\d+))?/i);
        if (!match) {
          chatClient.say(channel, `@${username} Usage: !prediction start "Title" A;B [durationSeconds]`);
        } else {
          const title = match[1];
          const outcomes = match[2].split(';').slice(0, 2);
          const duration = Number(match[3] || 120);
          await apiClient.predictions.createPrediction(broadcasterId, {
            title,
            outcomes: outcomes.map(o => ({ title: o })),
            predictionWindow: duration
          });
          chatClient.say(channel, `Prediction started: ${title}`);
        }
      } else if (raw.toLowerCase().startsWith('!prediction resolve')) {
        chatClient.say(channel, `@${username} Resolving predictions requires outcome ID (UI support TBD).`);
      }
    } catch (e) {
      chatClient.say(channel, `@${username} Failed to manage prediction: ${e.message}`);
    }
  }
  
  // !shoutout command (mods and broadcaster only)
  if (text.startsWith('!shoutout') || text.startsWith('!so')) {
    // Check if user is mod or broadcaster
    const isMod = msg.userInfo.isMod;
    const isBroadcaster = msg.userInfo.isBroadcaster;
    
    if (!isMod && !isBroadcaster) {
      chatClient.say(channel, `@${username} Only moderators and the broadcaster can use this command.`);
      return;
    }
    
    const parts = text.split(' ');
    if (parts.length < 2) {
      chatClient.say(channel, `@${username} Usage: !shoutout <username>`);
      return;
    }
    
    const targetUser = parts[1].replace('@', '');
    const result = await sendShoutout(targetUser);
    
    if (result.success) {
      chatClient.say(channel, `Go check out ${result.username} at https://twitch.tv/${targetUser} - they were last playing ${result.gameName}!`);
      logCommand(username, `!shoutout ${targetUser}`, channel, true);
    } else {
      chatClient.say(channel, `@${username} Failed to send shoutout: ${result.error}`);
      logCommand(username, `!shoutout ${targetUser}`, channel, false);
    }
  }
  
  // !commands - help command
  if (text === '!commands' || text === '!help') {
    chatClient.say(channel, 'Available commands: !clip, !followage [username], !shoutout [username] (mods only), !poll, !prediction, !title "new title" (mods), !game <name> (mods), !commands');
    logCommand(username, '!commands', channel, true);
    return;
  }

  // Custom commands
  const token = text.split(' ')[0];
  const tokenLc = token.toLowerCase();
  const tokenNoBang = tokenLc.startsWith('!') ? tokenLc.slice(1) : tokenLc;
  let matched = customCommands.find(cmd => cmd.name === tokenLc);
  if (!matched) {
    matched = customCommands.find(cmd => cmd.name === tokenNoBang);
  }
  if (matched) {
    const isMod = msg.userInfo.isMod;
    const isBroadcaster = msg.userInfo.isBroadcaster;

    const allowed = matched.level === 'everyone' 
      || matched.level === 'mod' && (isMod || isBroadcaster)
      || matched.level === 'broadcaster' && isBroadcaster;

    if (!allowed) {
      chatClient.say(channel, `@${username} You do not have permission to use this command.`);
      logCommand(username, matched.name, channel, false);
      return;
    }

    if (isOnCooldown(matched.name, matched.cooldownSeconds)) {
      const remainingMs = matched.cooldownSeconds * 1000 - (Date.now() - (commandCooldowns.get(matched.name) || 0));
      const remainingSec = Math.max(1, Math.ceil(remainingMs / 1000));
      chatClient.say(channel, `@${username} That command is on cooldown. Try again in ${remainingSec}s.`);
      logCommand(username, matched.name, channel, false);
      return;
    }

    const renderResult = await renderCustomCommand(matched, {
      user: msg.userInfo?.userName || username,
      displayName: msg.userInfo?.displayName || username,
      channel: channel.replace('#', ''),
      target: (message.split(' ')[1] || '').replace('@', '')
    });

    if (renderResult.error) {
      chatClient.say(channel, `@${username} ${renderResult.error}`);
      logCommand(username, matched.name, channel, false);
      return;
    }

    chatClient.say(channel, renderResult.rendered);
    setCooldown(matched.name);
    logCommand(username, matched.name, channel, true);
  }
});

// Start the bot
async function start() {
  console.log('Starting Twitch bot...');

  if (!broadcasterId) {
    await init();
    if (!broadcasterId) {
      throw new Error('Failed to initialize broadcaster ID');
    }
  }

  await loadCustomCommands();
  setInterval(loadCustomCommands, 30000);

  await chatClient.connect();

  console.log('✓ Connected to Twitch chat');
  console.log(`✓ Joined channels: ${config.channels.join(', ')}`);
  console.log('Bot is ready!');
}

chatClient.onConnect(() => {
  console.log('Chat client connected!');
});

chatClient.onDisconnect((manually, reason) => {
  console.log(`Disconnected: ${reason ? reason.message : 'Unknown reason'}`);
});

// Handle errors
process.on('unhandledRejection', (error) => {
  console.error('Unhandled promise rejection:', error);
});

start().catch(console.error);