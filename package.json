{
  "name": "twitch-chat-bot",
  "version": "1.0.0",
  "description": "Twitch chat bot with web dashboard",
  "main": "dist/bot/main.js",
  "type": "commonjs",
  "scripts": {
    "prebot": "npm run build",
    "bot": "node dist/bot/supervisor.js",
    "predashboard": "npm run build",
    "dashboard": "node dist/dashboard/main.js",
    "pretoken-generator": "npm run build",
    "token-generator": "node dist/token-generator/main.js",
    "start": "concurrently \"node dist/bot/supervisor.js\" \"node dist/dashboard/main.js\"",
    "dev": "npm run build && npm start",
    "build": "tsc && tsc -p tsconfig.web.json",
    "build:web": "tsc -p tsconfig.web.json",
    "build:watch": "tsc --watch",
    "pretest": "npm run build:web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "twitch",
    "bot",
    "chat",
    "streaming"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.13.2",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "tmi.js": "^1.8.5",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.2.0",
    "@types/tmi.js": "^1.8.6",
    "@types/ws": "^8.18.1",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.5.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
