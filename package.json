{
  "name": "twitch-chat-bot",
  "version": "1.0.0",
  "description": "Twitch chat bot with web dashboard",
  "main": "Excella.js",
  "type": "commonjs",
  "scripts": {
    "bot": "node Excella.js",
    "dashboard": "node dashboard/server.js",
    "dev": "concurrently \"npm run bot\" \"npm run dashboard\"",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "twitch",
    "bot",
    "chat",
    "streaming"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.13.2",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "tmi.js": "^1.8.5",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.2.0",
    "@types/ws": "^8.18.1",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
